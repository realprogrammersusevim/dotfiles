#!/usr/bin/env bash
# Switch the focused quick-check window between floating overlay and a tiled
# window in the current workspace. Its peek key keeps working either way.

source "$(dirname "$0")/wm.sh"

read -r id is_scratchpad slot < <(omniwmctl query windows --focused \
  --fields id,is-scratchpad,scratchpad-index --format json |
  jq -r '.result.payload.windows[0] | "\(.id) \(.isScratchpad) \(.scratchpadIndex)"')
[[ -n $id && $id != null ]] || exit 0

if [[ $is_scratchpad == true ]]; then
  # The mark lets peek find it while tiled, and lets us send it back.
  omniwmctl window mark set "peek-$slot" >/dev/null
  omniwmctl window assign-to-scratchpad "$id" "$slot" >/dev/null # releases it
  omniwmctl window focus "$id" >/dev/null
  exit 0
fi

read -r _ slot < <(wm_marked peek- | grep "^$id ")
[[ -n $slot ]] || exit 0
bundle_id=$(omniwmctl query windows --window "$id" --fields app --format json |
  jq -r '.result.payload.windows[0].app.bundleId')
omniwmctl window assign-to-scratchpad "$id" "$slot" >/dev/null
sleep 0.3 # wait for it to actually be parked before showing it again
wm_scratchpad_show_centered "$slot" "$id" "$bundle_id" # tiling changed its frame
